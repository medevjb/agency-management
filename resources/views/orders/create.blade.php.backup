                <script>
                    function userSelector() {
                        return {
                            allUsers: @js($users),
                            selectedUsers: [],
                            selectedUserIds: [],
                            searchQuery: '',
                            dropdownOpen: false,
                            filteredUsers: [],

                            init() {
                                console.log('UserSelector initialized with', this.allUsers.length, 'users');
                                this.filteredUsers = this.allUsers;
                            },

                            get availableUsers() {
                                return this.allUsers.filter(user =>
                                    !this.selectedUsers.find(selected => selected.id === user.id)
                                );
                            },

                            filterUsers() {
                                if (!this.searchQuery) {
                                    this.filteredUsers = this.availableUsers;
                                } else {
                                    const query = this.searchQuery.toLowerCase();
                                    this.filteredUsers = this.availableUsers.filter(user =>
                                        user.name.toLowerCase().includes(query) ||
                                        user.email.toLowerCase().includes(query)
                                    );
                                }
                            },

                            toggleDropdown() {
                                this.dropdownOpen = !this.dropdownOpen;
                                if (this.dropdownOpen) {
                                    this.filterUsers();
                                }
                            },

                            addUser(user) {
                                this.selectedUsers.push(user);
                                this.selectedUserIds.push(user.id);
                                this.searchQuery = '';
                                this.filterUsers();
                                this.$nextTick(() => {
                                    this.updateHiddenInput();
                                });
                            },

                            removeUser(userId) {
                                this.selectedUsers = this.selectedUsers.filter(u => u.id !== userId);
                                this.selectedUserIds = this.selectedUserIds.filter(id => id !== userId);
                                this.filterUsers();
                                this.$nextTick(() => {
                                    this.updateHiddenInput();
                                });
                            },

                            updateHiddenInput() {
                                const hiddenInput = document.querySelector('input[name="users[]"]');
                                if (hiddenInput) {
                                    // Remove old values
                                    hiddenInput.value = '';
                                    // Add new values
                                    this.selectedUserIds.forEach(id => {
                                        const option = document.createElement('option');
                                        option.value = id;
                                        option.selected = true;
                                        hiddenInput.add(option);
                                    });
                                }
                            }
                        }
                    }
                </script>
                <style>
                    [x-cloak] { display: none !important; }
                </style>

